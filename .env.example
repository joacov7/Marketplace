# Commerce OS — variables de entorno (ejemplo). NUNCA commitear el .env real.

# Postgres (Neon). El pooler en modo transacción es necesario para RLS con SET LOCAL.
DATABASE_URL="postgres://user:pass@host/dbname?sslmode=require"

# Postgres para tests de integración (aislamiento RLS). Si no está seteada, esos tests se saltan.
TEST_DATABASE_URL=""

# Redis serverless (Upstash) — cache de config + locks.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cola serverless para drenar el outbox (Upstash QStash) o Vercel Cron.
QSTASH_TOKEN=""

# Secretos de proveedores de pago se guardan cifrados por-merchant (KMS), NUNCA acá en claro.
