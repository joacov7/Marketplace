{
  "name": "commerce-os",
  "version": "0.0.0",
  "private": true,
  "description": "White Label Multi-Tenant Commerce OS. Core agnóstico de vertical, configuration-first, multi-tenant con aislamiento por RLS. Deploy full-stack en Vercel (Next.js) + Neon.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --dry",
    "clean": "tsc --build --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint packages apps",
    "migrate": "node scripts/migrate-prod.mjs",
    "seed": "node scripts/seed-demo.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15.5.26",
    "@types/node": "^20.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^2.1.9"
  }
}
